# The actual database is Cloudflare D1 (see wrangler.jsonc "d1_databases" and
# src/lib/prisma.ts), accessed through a Workers binding, not this URL. Prisma
# still requires a datasource url to be set for its CLI commands (generate,
# migrate diff) to run, but it's never connected to at runtime.
DATABASE_URL="file:./dev.db"

# `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
